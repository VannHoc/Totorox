<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>get-task-allow</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.MobileContainerManager.allowed</key>
	<true/>
	<key>com.apple.private.MobileGestalt.AllowedProtectedKeys</key>
	<array>
		<string>UniqueDeviceID</string>
	</array>
	<key>com.apple.private.mobileinstall.allowedSPI</key>
	<array>
		<string>Lookup</string>
		<string>CopyLiveSafeHarborForIdentifier</string>
	</array>
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
		<string>/var/mobile/Containers/Data/Application/</string>
		<string>/private/var/mobile/Containers/Data/Application/</string>
		<string>/var/containers/Bundle/Application/</string>
		<string>/private/var/containers/Bundle/Application/</string>
	</array>
	<!-- Tier 4 (worse_query). The group below MUST also be present in the
	     provisioning profile used to sign this build, otherwise
	     containerURL(forSecurityApplicationGroupIdentifier:) returns nil and
	     Tier 4 is unavailable (-1). If your profile has a different group,
	     change the string (or override it at runtime with the
	     "totorox.worseQueryGroup" user default). Remove this key only if
	     signing with a profile that cannot carry app groups: Tiers 1-3 keep
	     working unchanged. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.totorox.app</string>
	</array>
</dict>
</plist>
